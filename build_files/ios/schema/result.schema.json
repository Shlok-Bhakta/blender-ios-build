{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender.org/schemas/ios/result.schema.json",
  "title": "Blender iOS packet result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "packet",
    "status",
    "starting_sha",
    "ending_sha",
    "duration_seconds",
    "tests",
    "artifacts",
    "failure"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "packet": {"type": "string", "pattern": "^[NP][0-9]{3}$"},
    "status": {"enum": ["GREEN", "RED", "BLOCKED", "STALLED", "SKIPPED"]},
    "starting_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ending_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "tests": {"type": "array"},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "failure": {
      "type": ["object", "null"],
      "properties": {
        "code": {"type": "string"},
        "command": {"type": "string"},
        "root_error": {"type": "string"},
        "log": {"type": "string"}
      },
      "required": ["code", "command", "root_error", "log"],
      "additionalProperties": false
    }
  }
}
